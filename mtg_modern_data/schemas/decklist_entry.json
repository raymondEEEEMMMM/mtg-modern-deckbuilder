{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decklist Entry",
  "description": "Unified schema for individual 75-card decklist entries from MTGTop8 and MTGGoldfish",
  "type": "object",
  "required": ["source", "event_id", "event_name", "event_date", "deck_name", "deck_name_canonical", "player", "maindeck", "sideboard"],
  "properties": {
    "source": {"type": "string", "enum": ["mtgtop8", "mtggoldfish"]},
    "event_id": {"type": "string"},
    "event_name": {"type": "string"},
    "event_date": {"type": "string", "format": "date", "description": "YYYY-MM-DD ISO format"},
    "deck_id": {"type": "string"},
    "deck_name": {"type": "string", "description": "Raw name from source"},
    "deck_name_canonical": {"type": "string", "description": "Normalized canonical archetype name"},
    "deck_name_raw": {"type": "string", "description": "Original name before normalization (set when different from deck_name)"},
    "player": {"type": "string"},
    "placement": {"type": ["string", "integer", "null"]},
    "maindeck": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["qty", "name"],
        "properties": {
          "qty": {"type": "integer", "minimum": 1},
          "name": {"type": "string"}
        }
      }
    },
    "sideboard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["qty", "name"],
        "properties": {
          "qty": {"type": "integer", "minimum": 1},
          "name": {"type": "string"}
        }
      }
    },
    "maindeck_count": {"type": "integer", "minimum": 0},
    "sideboard_count": {"type": "integer", "minimum": 0},
    "legality": {
      "type": "object",
      "properties": {
        "legal": {"type": "boolean"},
        "banned_cards": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"type": "object"}
            ]
          }
        }
      }
    }
  }
}
